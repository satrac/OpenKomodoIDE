+class _SccCatCallback(object):
+    """XPCOM callback adapter for the Python bound method.
+
+    PyXPCOM does not automatically wrap a bound method as a
+    koIAsyncCallback in Python 3, so pass an object that explicitly
+    implements the interface.
+    """
+    _com_interfaces_ = [components.interfaces.koIAsyncCallback]
+
+    def __init__(self, tracker):
+        self._tracker = tracker
+
+    def callback(self, result, data):
+        self._tracker._sccCatCallback(result, data)
+
+
