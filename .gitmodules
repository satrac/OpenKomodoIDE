# These are not gitlinks in this tree; `make modules` clones them into place
# from the forked repositories when a full build is wanted.
[submodule "src/modules/trackchanges"]
	path = src/modules/trackchanges
	url = https://github.com/satrac/trackchanges.git
	branch = master
[submodule "src/modules/golang"]
	path = src/modules/golang
	url = https://github.com/satrac/komodo-go.git
	branch = master
[submodule "src/modules/editorconfig"]
	path = src/modules/editorconfig
	url = https://github.com/satrac/komodo-editorconfig.git
[submodule "src/modules/focusmode"]
	path = src/modules/focusmode
	url = https://github.com/satrac/Focus-Mode.git
# The CodeIntel server is vendored under src/modules/codeintel/server (its
# original Komodo/codeintel repository is gone), so it is not listed here.

