<?xml version="1.0"?>
<!DOCTYPE window SYSTEM "http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul" [
  <!ENTITY % prefDTD SYSTEM "chrome://komodo/locale/pref/pref.dtd">
  %prefDTD;
  <!ENTITY % prefDTD.INTERNAL SYSTEM "chrome://komodo/locale/pref-internal.dtd">
  %prefDTD.INTERNAL;
]>

<!-- Copyright (c) 2026 ActiveState Software Inc.
     See the file LICENSE.txt for licensing information. -->

<?xml-stylesheet href="less://komodo/skin/global/global.less" type="text/css"?>
<?xml-stylesheet href="chrome://komodo/skin/bindings/buttons.css" type="text/css"?>
<?xml-stylesheet href="chrome://komodo/skin/bindings/widgets.css" type="text/css"?>
<?xml-stylesheet href="chrome://komodo/skin/bindings/listbox.css" type="text/css"?>
<?xml-stylesheet href="chrome://komodo/skin/prefs/prefs.css" type="text/css"?>

<window xmlns:html="http://www.w3.org/1999/xhtml"
        xmlns="http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul"
        class="kodialog pref-window"
        orient="vertical"
        onload="PrefRaku_OnLoad();">

    <script src="chrome://xtk/content/xtk.js" type="application/x-javascript;version=1.7"/>
    <script src="chrome://komodo/content/library/logging.js" type="application/x-javascript;version=1.7"/>
    <script src="chrome://komodo/content/library/dialogs.js" type="application/x-javascript;version=1.7"/>
    <script src="chrome://komodo/content/library/filepickers.js" type="application/x-javascript;version=1.7"/>
    <script src="chrome://komodo/content/pref/pref-raku.js" type="application/x-javascript;version=1.7"/>
    <script src="chrome://komodo/content/pref/koPrefUtils.js" type="application/x-javascript;version=1.7" />
    <script src="chrome://komodo/content/library/windowManager.js" type="application/x-javascript;version=1.7"/>

    <vbox id="raku-prefs-vbox" flex="1" class="autoscroll">

        <groupbox orient="vertical" id="defaultRakuInterpreterGroupBox">
            <caption label="&defaultRakuInterpreter.label;"/>
            <vbox flex="1" align="center" id="no-avail-interps-message" collapsed="true">
                <description style="font-weight: bold;">
                    &noRakuInterpreter.description;
                </description>
                <button label="&httpRakuOrg.label;"
                        class="button-link-a" style="cursor:pointer;"
                        oncommand="alert('&noteRestartRaku.alert;'); getKoObject('browse').openUrlInDefaultBrowser('https://raku.org/');"/>
            </vbox>
            <text value="&filePrefRakuUseThisInterpreter.label;" style="padding: 2px 6px 2px 6px"/>
            <hbox align="center">
                <menulist id="rakuDefaultInterpreter"
                    flex="1"
                    pref="true"
                    prefstring="rakuDefaultInterpreter">
                    <menupopup id="avail-interp-list"/>
                </menulist>
                <button label="&browse.label;" oncommand="loadRakuExecutable();"/>
            </hbox>
        </groupbox>

        <separator class="thin"/>

        <groupbox orient="vertical">
            <caption label="&additionalRakuImportDirectories.label;"/>
            <description>
                &filePrefRakuAdditionalDirectory.description;
            </description>
            <pathlist
                    id="rakuExtraPaths"
                    flex="1"
                    seltype="multiple"
                    rows="4"
                    pref="true" prefwidget="true"
                    prefstring="rakuExtraPaths"/>
            <vbox collapsed="true">
              <description>
                  &filePrefRakuExcludeDirectory.description;
              </description>
              <pathlist
                      id="rakuExcludePaths"
                      flex="1"
                      seltype="multiple"
                      rows="4"
                      pref="true" prefwidget="true"
                      prefstring="rakuExcludePaths"/>
            </vbox>
        </groupbox>

        <separator class="thin"/>

        <groupbox orient="vertical">
            <caption label="&rakuDebugger.label;"/>
            <description>&rakuDapCommand.description;</description>
            <label value="&rakuDapCommand.label;" control="rakuDapCommand"/>
            <textbox id="rakuDapCommand" flex="1" pref="true"
                     prefstring="rakuDapCommand"/>
            <label value="&rakuDapArgs.label;" control="rakuDapArgs"/>
            <textbox id="rakuDapArgs" flex="1" pref="true"
                     prefstring="rakuDapArgs"/>
            <checkbox id="rakuStopOnEntry" label="&rakuStopOnEntry.label;"
                      pref="true" prefstring="rakuStopOnEntry"
                      prefattribute="checked"/>
        </groupbox>

        <separator class="thin"/>

        <groupbox orient="vertical">
            <caption label="&rakuLanguageServer.label;"/>
            <checkbox id="rakuLspEnabled" label="&rakuLspEnabled.label;"
                      pref="true" prefstring="rakuLspEnabled"
                      prefattribute="checked"/>
            <label value="&rakuLspCommand.label;" control="rakuLspCommand"/>
            <textbox id="rakuLspCommand" flex="1" pref="true"
                     prefstring="rakuLspCommand"/>
            <label value="&rakuLspArgs.label;" control="rakuLspArgs"/>
            <textbox id="rakuLspArgs" flex="1" pref="true"
                     prefstring="rakuLspArgs"/>
        </groupbox>

    </vbox>

</window>
