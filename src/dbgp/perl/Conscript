#!/usr/local/bin/perl
# Install the Perl DBGP debugger library.  This is required by both the
# Perl debugger and the Perl interactive shell (via PERL5DB).

Import(
    'cons',
    'supportDir',
);

$cons->InstallRecursive("$supportDir/dbgp/perllib",
                        # InstallRecursive requires an absolute source path.
                        cwd()."/src/dbgp/perl",
                        ('Conscript', '\.consign', '\.pyc$'));
