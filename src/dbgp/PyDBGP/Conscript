#!/usr/local/bin/perl
# Install the Python 3 DBGP client (the debugger side that runs in the
# user's Python process).  The IDE-side dbgp package is installed by
# src/dbgp/Conscript.
#
# Python 2 target debugging is not supported; only py3_dbgp and python3lib
# are installed.

Import(
    'cons',
    'supportDir',
);

my $dbgpDir = "$supportDir/dbgp";

$cons->Install("$dbgpDir/bin",
               'bin/py3_dbgp',
               'bin/py3_dbgp.py');

# Python 3 client library.  The prebuilt _clientNN extension modules target
# old ABIs, so only the pure-Python files are needed; client.py falls back to
# dbgp/_pyclient.py when the accelerator cannot be imported.
$cons->Install("$dbgpDir/python3lib/dbgp",
               'python3lib/dbgp/__init__.py',
               'python3lib/dbgp/client.py',
               'python3lib/dbgp/common.py',
               'python3lib/dbgp/listcmd.py',
               'python3lib/dbgp/server.py',
               'python3lib/dbgp/serverBase.py',
               'python3lib/dbgp/_pyclient.py');
