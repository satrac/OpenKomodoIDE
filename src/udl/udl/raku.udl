# Lexer description for Raku (formerly Perl 6).
#
# This is a dedicated UDL lexer.  It intentionally follows Raku's sigils,
# twigils, quoting forms, regex forms, comments and POD rather than reusing
# Scintilla's Perl lexer.
#
# Known approximations:
# - heredocs end at the first bare-word line (no exact terminator tracking)
# - string interpolation is painted as part of the string
# - some Unicode metaoperators are painted as generic operators

language Raku

################ Boilerplate ################

family markup
initial IN_M_DEFAULT
state IN_M_DEFAULT:
/./ : redo, => IN_SSL_DEFAULT

################ Language Start ################

family ssl
sublanguage Raku

start_style SSL_DEFAULT
end_style SSL_VARIABLE

keyword_style SSL_IDENTIFIER => SSL_WORD
keywords [
    "BEGIN", "CHECK", "INIT", "END", "ENTER", "LEAVE", "KEEP", "UNDO",
    "FIRST", "NEXT", "LAST", "QUIT", "also", "and", "any", "async", "augment",
    "await", "bag", "bags", "but", "cancel", "catch", "category", "class",
    "constant", "continuing", "default", "die", "do", "does", "done", "else",
    "elsif", "emit", "enum", "eq", "eqv", "export", "fail", "false", "for",
    "gather", "given", "grammar", "handles", "has", "hyper", "hyperwhatever",
    "if", "import", "in", "is", "isa", "last", "lazy", "leave", "let", "like",
    "loop", "macro", "make", "map", "maybe", "method", "module", "monitor",
    "multi", "my", "need", "next", "no", "none", "not", "note", "native",
    "of", "only", "or", "our", "optional", "package", "pass", "plan", "proto",
    "proceed", "prompt", "put", "quietly", "race", "react", "redo", "regex",
    "require", "return", "return-rw", "reverse", "role", "rule", "rw", "say",
    "self", "slang", "start", "state", "sub", "subset", "supersede", "supply",
    "take", "temp", "trait", "true", "try", "twigil", "unit", "unless",
    "until", "use", "when", "where", "while", "with", "without", "x", "xor",
    "yield", "Any", "Array", "Associative", "atomicint", "Attribute",
    "Backtrace", "Bag", "BagHash", "Blob", "Bool", "Buf", "Callable",
    "Capture", "Channel", "Code", "Complex", "Cool", "Date", "DateTime",
    "Duration", "Exception", "Failure", "FatRat", "Grammar", "Hash",
    "Instant", "Int", "IntStr", "Iterable", "Iterator", "Junction", "Label",
    "List", "Lock", "Map", "Match", "Mix", "MixHash", "Mu", "NFC", "NFD",
    "NFKC", "NFKD", "Nil", "Num", "Numeric", "NumStr", "ObjAt", "Pair",
    "Positional", "Proc", "Promise", "Proxy", "Range", "Rat", "RatStr",
    "Real", "Regex", "Routine", "Scalar", "Seq", "Set", "SetHash",
    "Signature", "Slip", "Stash", "Str", "Stringy", "Sub", "Submethod",
    "Supply", "Tap", "Thread", "UInt", "UTF8", "Version", "Whatever",
    "WhateverCode", "abs", "all", "antipair", "any", "append", "Array",
    "AT-POS", "Bag", "base", "basename", "batch", "bell", "bind", "bless",
    "Bool", "bools", "categorize", "chars", "chdir", "chmod", "chomp", "chop",
    "chr", "classify", "clone", "close", "comb", "combinations", "contains",
    "copy", "cos", "cpu-cores", "Date", "day", "decode", "deepmap", "defined",
    "dir", "dirname", "dl", "duckmap", "elems", "encode", "end", "eof",
    "exit", "exp", "extension", "first", "flat", "flip", "fmt", "fullname",
    "gist", "grep", "hash", "head", "hh", "index", "indices", "IO",
    "is-absolute", "is-dir", "is-file", "join", "key", "keys", "kv", "last",
    "lc", "lines", "list", "log", "log10", "map", "match", "max", "min",
    "mix", "mkdir", "move", "next", "new", "nl-in", "nl-out", "not", "note",
    "open", "ord", "pair", "pairs", "parse", "permutations", "pick", "pop",
    "pop", "print", "printf", "prompt", "push", "put", "rand", "read", "redo",
    "reduce", "reverse", "rmdir", "roll", "roots", "rotate", "round", "run",
    "samecase", "say", "sort", "splice", "split", "sprintf", "sqrt", "squish",
    "start", "subst", "sum", "tail", "tc", "trim", "trim-leading",
    "trim-trailing", "truncate", "uc", "unique", "unlink", "unshift", "value",
    "values", "words", "write", "zip"
]

pattern FIRSTNAMECHAR = '_\w\x80-\xff'
pattern NAMECHAR = '$FIRSTNAMECHAR\d'
pattern NAME = '[$FIRSTNAMECHAR][$NAMECHAR\-\x27:]*'
pattern WS = '\s\t\r\n'
pattern OP = '~!#^&*()-=+\[\]\{\}\\\|;:,<.>\/\?'
pattern TWIGIL = '[!.\^?*+=~:]'

initial IN_SSL_DEFAULT
state IN_SSL_DEFAULT:

# Comments and POD
/=begin\b[\s\S]*?=end\b[^\n]*/ : paint(upto, SSL_DEFAULT), paint(include, SSL_COMMENT)
/=begin\b/ : paint(upto, SSL_DEFAULT), paint(include, SSL_COMMENT), => IN_SSL_POD_BLOCK
/=(?:begin|end|for|pod|comment|config|encoding|head\d+|item\d*|defn|table|para|abbr|place|nested|declarator|method|submethod|routine|class|role|grammar|module|package|multi|proto|only|also|unit|use|need|require|import|no)\b/ : paint(upto, SSL_DEFAULT), paint(include, SSL_COMMENT)
/#/ : paint(upto, SSL_DEFAULT), => IN_SSL_COMMENT_1
/[$WS]+/  : #stay

# Plain strings
'"' : paint(upto, SSL_DEFAULT), => IN_SSL_DSTRING
'\'' : paint(upto, SSL_DEFAULT), => IN_SSL_SSTRING

# Quote adverbs and heredocs must be recognized before the bare q forms.
/(?:qq|Q|q):to([^\w\d])/ : paint(upto, SSL_DEFAULT), paint(include, SSL_STRING), => IN_SSL_HEREDOC_1
/(?:qq|qw|qx|q|Q):[a-zA-Z!]+/ : paint(upto, SSL_DEFAULT), paint(include, SSL_IDENTIFIER), => IN_SSL_PRE_QSTRING
/(?:rx|m|s|tr):[a-zA-Z!]+/ : paint(upto, SSL_DEFAULT), paint(include, SSL_OPERATOR), => IN_SSL_PRE_REGEX_1

# Quoting forms: q, qq, Q, qw, qx
/(?:qq|qw|qx|q|Q)([\{\[\(\<])/ : paint(upto, SSL_DEFAULT), set_opposite_delimiter(1), => IN_SSL_QSTRING_NESTED
/(?:qq|qw|qx|q|Q)([^\w\d])/ : paint(upto, SSL_DEFAULT), set_delimiter(1), => IN_SSL_QSTRING

# Regex forms: m, rx, s, tr
/(?:rx|m)([\{\[\(\<])/ : paint(upto, SSL_DEFAULT), set_opposite_delimiter(1), => IN_SSL_REGEX1_TARGET
/(?:rx|m)([^\w\d])/ : paint(upto, SSL_DEFAULT), set_delimiter(1), => IN_SSL_REGEX1_TARGET
/(?:tr|s)([\{\[\(\<])/ : paint(upto, SSL_DEFAULT), set_opposite_delimiter(1), => IN_SSL_REGEX2_TARGET1_OPPOSITE_1
/(?:tr|s)([^\w\d])/ : paint(upto, SSL_DEFAULT), set_delimiter(1), => IN_SSL_REGEX2_TARGET1_SAME
'!~~' : paint(upto, SSL_DEFAULT), paint(include, SSL_OPERATOR) => IN_SSL_PRE_REGEX_1
'~~' : paint(upto, SSL_DEFAULT), paint(include, SSL_OPERATOR) => IN_SSL_PRE_REGEX_1
'=~' : paint(upto, SSL_DEFAULT), paint(include, SSL_OPERATOR) => IN_SSL_PRE_REGEX_1
'/' token_check : paint(upto, SSL_DEFAULT) => IN_SSL_REGEX_1

# Numbers
/0x[0-9a-fA-F_]*/ : paint(upto, SSL_DEFAULT), paint(include, SSL_NUMBER)
/0b[01_]*/ : paint(upto, SSL_DEFAULT), paint(include, SSL_NUMBER)
/0o[0-7_]*/ : paint(upto, SSL_DEFAULT), paint(include, SSL_NUMBER)
/0[0-7_]*/ : paint(upto, SSL_DEFAULT), paint(include, SSL_NUMBER)
/[1-9]/ : paint(upto, SSL_DEFAULT), => IN_SSL_NUMBER_1
/\.(?=\d)/ : paint(upto, SSL_DEFAULT), => IN_SSL_NUMBER_2

# Variables with sigils and twigils
/[$@%&]/ : paint(upto, SSL_DEFAULT), paint(include, SSL_VARIABLE), => IN_SSL_SIGIL

# Bare names
/[$FIRSTNAMECHAR]/ : paint(upto, SSL_DEFAULT), => IN_SSL_IDENTIFIER_1

# Operators
/[$OP]/ : paint(upto, SSL_DEFAULT), paint(include, SSL_OPERATOR)

# Fallback
/./ : paint(upto, SSL_DEFAULT), paint(include, SSL_DEFAULT)

################ Comments and POD ################

state IN_SSL_COMMENT_1:
/$/ : paint(include, SSL_COMMENT), => IN_SSL_DEFAULT

state IN_SSL_POD_LINE:
/=begin\b/ : paint(include, SSL_COMMENT), => IN_SSL_POD_BLOCK
/$/ : paint(include, SSL_COMMENT), => IN_SSL_DEFAULT

state IN_SSL_POD_BLOCK:
/=end\b.*/ : paint(include, SSL_COMMENT), => IN_SSL_DEFAULT
/.+/ : paint(include, SSL_COMMENT) #stay

################ Strings ################

state IN_SSL_DSTRING:
'"' : paint(include, SSL_STRING), => IN_SSL_DEFAULT
/\\./ : #stay

state IN_SSL_SSTRING:
'\'' : paint(include, SSL_STRING), => IN_SSL_DEFAULT
/\\./ : #stay

state IN_SSL_PRE_QSTRING:
/[$WS]+/ : #stay
/([\{\[\(\<])/ : paint(upto, SSL_DEFAULT), set_opposite_delimiter(1), => IN_SSL_QSTRING_NESTED
/([^\w\d])/ : paint(upto, SSL_DEFAULT), set_delimiter(1), => IN_SSL_QSTRING
/./ : paint(upto, SSL_DEFAULT), redo, => IN_SSL_DEFAULT

state IN_SSL_HEREDOC_1:
/^[A-Za-z_]\w*$/ : paint(include, SSL_STRING), => IN_SSL_DEFAULT
/.+/ : paint(include, SSL_STRING) #stay

state IN_SSL_QSTRING:
delimiter: paint(include, SSL_STRING), => IN_SSL_DEFAULT
/\\./ : #stay
/\z/ : paint(include, SSL_STRING)

state IN_SSL_QSTRING_NESTED:
delimiter: paint(include, SSL_STRING), => IN_SSL_DEFAULT
/\\./ : #stay
/[\[\{\(\<]/ : paint(upto, SSL_STRING), spush_check(IN_SSL_QSTRING_NESTED), => IN_SSL_QSTRING_NESTED2
/\z/ : paint(include, SSL_STRING)

state IN_SSL_QSTRING_NESTED2:
/\\./ : #stay
/[\[\{\(\<]/ : spush_check(IN_SSL_QSTRING_NESTED2), => IN_SSL_QSTRING_NESTED2
/[\]\}\)\>]/ : spop_check, => IN_SSL_QSTRING_NESTED
/\z/ : paint(include, SSL_STRING)

################ Numbers ################

state IN_SSL_NUMBER_1:
/$/ : paint(upto, SSL_NUMBER), => IN_SSL_DEFAULT
/[_]/ : #stay
'.' : => IN_SSL_NUMBER_2
/[\d]/ : #stay
/[Ee][-+]?/ : => IN_SSL_NUMBER_3
/./ : paint(upto, SSL_NUMBER), redo, => IN_SSL_DEFAULT

state IN_SSL_NUMBER_2:
/$/ : paint(upto, SSL_NUMBER), => IN_SSL_DEFAULT
/[\d]/ : #stay
/[Ee][-+]?/ : => IN_SSL_NUMBER_3
'.' : paint(upto, SSL_NUMBER), paint(include, SSL_OPERATOR), => IN_SSL_DEFAULT
/./ : paint(upto, SSL_NUMBER), redo, => IN_SSL_DEFAULT

state IN_SSL_NUMBER_3:
/$/ : paint(upto, SSL_NUMBER), => IN_SSL_DEFAULT
/[^\d]/ : paint(upto, SSL_NUMBER), redo, => IN_SSL_DEFAULT

################ Variables ################

state IN_SSL_SIGIL:
/$TWIGIL/ : paint(include, SSL_VARIABLE), => IN_SSL_VARNAME
/[$NAMECHAR\-:]+/ : paint(include, SSL_VARIABLE), => IN_SSL_VARNAME
/[\/_0-9¢]/ : paint(include, SSL_VARIABLE), => IN_SSL_DEFAULT
/./ : redo, => IN_SSL_DEFAULT

state IN_SSL_VARNAME:
/[$NAMECHAR\-:]+/ : paint(include, SSL_VARIABLE)
/./ : redo, => IN_SSL_DEFAULT

################ Names ################

state IN_SSL_IDENTIFIER_1:
/[$NAMECHAR\-:]+/ : #stay
/./ : redo, paint(upto, SSL_IDENTIFIER), => IN_SSL_DEFAULT

################ Regexes ################

state IN_SSL_PRE_REGEX_1:
/[$WS]+/ : #stay
/(?:s|tr|m|rx):[a-zA-Z!]+/ : paint(include, SSL_OPERATOR), => IN_SSL_PRE_REGEX_1
/m?([\{\[\(\<])/ : paint(upto, SSL_DEFAULT), set_opposite_delimiter(1), => IN_SSL_REGEX1_TARGET
/m?([^\w\d])/ : paint(upto, SSL_DEFAULT), set_delimiter(1), => IN_SSL_REGEX1_TARGET
/s([\{\[\(\<])/ : paint(upto, SSL_DEFAULT), set_opposite_delimiter(1), => IN_SSL_REGEX2_TARGET1_OPPOSITE_1
/s([^\w\d])/ : paint(upto, SSL_DEFAULT), set_delimiter(1), => IN_SSL_REGEX2_TARGET1_SAME
/./ : paint(upto, SSL_DEFAULT), redo, => IN_SSL_DEFAULT

state IN_SSL_REGEX_1:
/\\./ : #stay
/\/[\w]*/ : paint(include, SSL_REGEX), => IN_SSL_DEFAULT
/#[^\/]*$/ : paint(upto, SSL_REGEX), paint(include, SSL_COMMENT) # stay
/[\r\n]/ : #stay

state IN_SSL_REGEX1_TARGET:
delimiter: paint(include, SSL_REGEX), => IN_SSL_REGEX_POST
/\\./ #stay
/\#[^\/]*$/ : paint(upto, SSL_REGEX), paint(include, SSL_COMMENT) # stay

state IN_SSL_REGEX_POST:
/\w+/ : paint(include, SSL_REGEX), => IN_SSL_DEFAULT
// : => IN_SSL_DEFAULT

state IN_SSL_REGEX2_TARGET1_OPPOSITE_1:
/\\./ : #stay
delimiter: paint(include, SSL_REGEX), => IN_SSL_REGEX2_TARGET1_OPPOSITE_2
/\z/ : paint(upto, SSL_REGEX)

state IN_SSL_REGEX2_TARGET1_OPPOSITE_2:
/\\./ : #stay
/[$WS]/ : #stay
/\#.*$/ : paint(upto, SSL_DEFAULT), paint(include, SSL_COMMENT) #stay
/([\{\[\(\<])/ : paint(upto, SSL_DEFAULT), set_opposite_delimiter(1), => IN_SSL_REGEX1_TARGET
/([^\w\d])/ : paint(upto, SSL_DEFAULT), set_delimiter(1), => IN_SSL_REGEX1_TARGET
/\z/ : paint(upto, SSL_DEFAULT)

state IN_SSL_REGEX2_TARGET1_SAME:
/\\./ : #stay
delimiter: keep_delimiter, => IN_SSL_REGEX1_TARGET
/\z/ : paint(upto, SSL_REGEX)

################ End States ################

token_check:
SSL_OPERATOR: accept ['(', '{', '[', ';', '..', '...', '=', '=>']
SSL_WORD: accept [split, grep, map, say, print, put, if, unless, until, and, or, not, xor, given, when, with, without]
SSL_DEFAULT: skip all
SSL_VARIABLE: reject all
SSL_COMMENT: skip all

################ Fold Info ################

fold "{" SSL_OPERATOR +
fold "}" SSL_OPERATOR -
fold "[" SSL_OPERATOR +
fold "]" SSL_OPERATOR -
fold "(" SSL_OPERATOR +
fold ")" SSL_OPERATOR -
