+// py3compat.h - compatibility shims for the Python 3 C API.
+//
+// This file maps the small set of Python 2 C API spellings that PyXPCOM still
+// uses onto their Python 3 equivalents.  The important semantic decision is
+// that the old Python 2 "str" (a byte string) maps onto Python 3 "str" for
+// XPCOM text, while still accepting (and transparently handling) bytes where
+// the old API would have produced them.
+//
+// Must be included after <Python.h>.
+
+#ifndef __PYXPCOM_PY3COMPAT_H__
+#define __PYXPCOM_PY3COMPAT_H__
+
+#include <Python.h>
+
+#if PY_MAJOR_VERSION < 3
+#error "PyXPCOM now requires Python 3"
+#endif
+
+// Return a NUL terminated UTF-8 view of a str or bytes object.  For str
+// objects the buffer is owned by the object and remains valid for as long as
+// the object does.
+static inline const char *
+PyXPCOM_StringAsUTF8(PyObject *op)
+{
+	if (op == NULL)
+		return NULL;
+	if (PyBytes_Check(op))
+		return PyBytes_AS_STRING(op);
+	if (PyUnicode_Check(op))
+		return PyUnicode_AsUTF8(op);
+	PyErr_Format(PyExc_TypeError, "expected str or bytes, not %.200s",
+	             Py_TYPE(op)->tp_name);
+	return NULL;
+}
+
+// Return the size of the UTF-8 representation of a str or bytes object.
+static inline Py_ssize_t
+PyXPCOM_StringSize(PyObject *op)
+{
+	if (op == NULL)
+		return -1;
+	if (PyBytes_Check(op))
+		return PyBytes_GET_SIZE(op);
+	if (PyUnicode_Check(op)) {
+		Py_ssize_t size = 0;
+		if (PyUnicode_AsUTF8AndSize(op, &size) == NULL)
+			return -1;
+		return size;
+	}
+	return -1;
+}
+
+// Build a str from UTF-8 data.  If the data is not valid UTF-8 we fall back
+// to returning bytes, which keeps binary data working the way it did with
+// Python 2 strings.
+static inline PyObject *
+PyXPCOM_StringFromUTF8(const char *s, Py_ssize_t size)
+{
+	PyObject *ret = PyUnicode_DecodeUTF8(s, size, NULL);
+	if (ret != NULL)
+		return ret;
+	PyErr_Clear();
+	return PyBytes_FromStringAndSize(s, size);
+}
+
+// Return the single code point held by a str of length 1.
+static inline Py_UCS4
+PyXPCOM_UnicodeChar(PyObject *op)
+{
+	if (op == NULL || !PyUnicode_Check(op) ||
+	    PyUnicode_GET_LENGTH(op) != 1)
+		return 0;
+	return PyUnicode_READ_CHAR(op, 0);
+}
+
+// PyMethodChain / Py_FindMethodInChain were removed in Python 3.  PyXPCOM
+// uses them for interface method lookup, so provide a small local replacement.
+struct PyXPCOMMethodChain {
+	struct PyMethodDef *methods;
+	struct PyXPCOMMethodChain *link;
+};
+
+static inline PyObject *
+PyXPCOM_FindMethodInChain(PyXPCOMMethodChain *chain, PyObject *self,
+                          const char *name)
+{
+	for (; chain != NULL; chain = chain->link) {
+		if (chain->methods == NULL)
+			continue;
+		for (struct PyMethodDef *m = chain->methods; m->ml_name != NULL; ++m) {
+			if (strcmp(m->ml_name, name) == 0)
+				return PyCFunction_New(m, self);
+		}
+	}
+	PyErr_Format(PyExc_AttributeError,
+	             "'%.200s' object has no attribute '%s'",
+	             Py_TYPE(self)->tp_name, name);
+	return NULL;
+}
+
+// Python 2 string API -> Python 3 str/bytes API.
+#define PyString_Check(op) \
+	(PyUnicode_Check(op) || PyBytes_Check(op))
+#define PyString_FromString(s) \
+	PyUnicode_FromString(s)
+#define PyString_FromStringAndSize(s, n) \
+	PyXPCOM_StringFromUTF8((s), (n))
+#define PyString_AsString(op) \
+	((char *)PyXPCOM_StringAsUTF8((PyObject *)(op)))
+#define PyString_AS_STRING(op) \
+	((char *)PyXPCOM_StringAsUTF8((PyObject *)(op)))
+#define PyString_GET_SIZE(op) \
+	PyXPCOM_StringSize((PyObject *)(op))
+#define PyString_Size(op) \
+	PyXPCOM_StringSize((PyObject *)(op))
+
+// Python 2 integer API -> Python 3 long API.
+#define PyInt_Check(op)                    PyLong_Check(op)
+#define PyInt_FromLong(v)                  PyLong_FromLong(v)
+#define PyInt_AsLong(v)                    PyLong_AsLong(v)
+#define PyInt_AsUnsignedLongLongMask(v)    PyLong_AsUnsignedLongLongMask(v)
+#define PyNumber_Int                       PyNumber_Long
+
+// Python 2 call API.
+#define PyEval_CallObject(func, args)      PyObject_CallObject((func), (args))
+
+// Removed unicode size helpers.
+#define PyUnicode_GetSize(op)              PyUnicode_GET_LENGTH(op)
+#ifndef PyUnicode_GET_SIZE
+#define PyUnicode_GET_SIZE(op)             PyUnicode_GET_LENGTH(op)
+#endif
+
+#endif // __PYXPCOM_PY3COMPAT_H__
